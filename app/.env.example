# Where the app finds the TeachWise API.
# Phone on the same Wi-Fi as your computer (development): use your computer's IP address.
# Published web app / store build: your real HTTPS address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api

# The web app's address, used in school join links shared from phones.
EXPO_PUBLIC_WEB_URL=https://teachwise.example.edu

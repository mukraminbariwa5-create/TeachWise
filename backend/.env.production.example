# Copy to .env on the server, fill in the values marked "example", then run: php artisan key:generate
APP_NAME=TeachWise
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://teachwise.example.edu
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# XAMPP MySQL. Uses a NEW database so your old fefs_db is never touched.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teachwise_db
DB_USERNAME=teachwise_user
DB_PASSWORD=change-me-to-a-long-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Professor JAG (Ollama), used in a later phase
OLLAMA_ENABLED=false
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ---- TeachWise
# Who runs this TeachWise server (shown before anyone signs in). Each school sets its own
# name, logo and contacts in the app.
TEACHWISE_PLATFORM_NAME=TeachWise
TEACHWISE_SUPPORT_EMAIL=support@example.edu
TEACHWISE_DPO_EMAIL=dpo@example.edu
# Only used once, when an older single-school install is upgraded into its first school.
TEACHWISE_SCHOOL_NAME="My School"
# Raise LATEST when you publish a new app version; raise MIN to force old versions to update.
TEACHWISE_LATEST_APP_VERSION=1.0.0
TEACHWISE_MIN_APP_VERSION=1.0.0
TEACHWISE_STORE_URL=https://play.google.com/store/apps/details?id=com.teachwise.app
TEACHWISE_SESSION_DAYS=30
TEACHWISE_SHORT_SESSION_HOURS=12

# Which web addresses may call the API. "*" is fine on your own computer;
# in production list your web app address, e.g. https://teachwise.example.edu
CORS_ALLOWED_ORIGINS=https://teachwise.example.edu

# Push notifications to phones through Expo (free, no key needed).
EXPO_PUSH_ENABLED=true
